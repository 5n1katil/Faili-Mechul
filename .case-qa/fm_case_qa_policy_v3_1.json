{
  "schema_version": "fm_case_qa_automation_policy_v3_8",
  "source": {
    "repository": "5n1katil/Faili-Mechul",
    "branch": "main",
    "standard_path": "artifacts/dedektif/data/puzzles.ts",
    "premium_path": "artifacts/dedektif/data/puzzles_database.json",
    "sidecar_path": "artifacts/dedektif/qa/case_qa_sidecars_v29_5.json",
    "expected_standard_cases": 45,
    "expected_premium_cases": 60,
    "expected_total_cases": 105
  },
  "simulator": {
    "version": "29.4",
    "minimum_score": 100,
    "require_production_ready": true,
    "require_core_necessity": true,
    "require_identity_guard": true,
    "require_preclue_guard_pass": true,
    "require_avatar_prompt_risk_false": true,
    "path": ".case-qa/Faili_Mechul_Vaka_Simulatoru_v29_4_Otomasyon_Temeli.html",
    "git_blob_sha": "f4bd5f5c30ccdf8cf552b7dc3377311afbcb0660"
  },
  "repair": {
    "confirmed_preclue_leakage_only": true,
    "repair_all_exact_failures_after_gold_calibration": true,
    "pilot_requires_explicit_case_ids": true,
    "preserve_case_ids": true,
    "preserve_entity_ids": true,
    "preserve_clue_ids": true,
    "preserve_solution_ids": true,
    "preserve_icons_and_asset_paths": true,
    "max_luna_attempts_per_case": 1,
    "max_terra_attempts_per_case": 2,
    "quarantine_after_failed_escalation": true,
    "require_monotonic_candidate_improvement": true
  },
  "authoring": {
    "enabled": true,
    "qa_only_fields": true,
    "production_content_hash_must_match": true,
    "model": "gpt-5.6-luna",
    "reasoning_effort": "medium",
    "max_output_tokens": 9000,
    "max_attempts_per_case": 1,
    "gold_recovery_attempts": 1,
    "gold_recovery_model": "gpt-5.6-terra",
    "gold_recovery_reasoning_effort": "medium",
    "calibration_case_ids": [
      "rc_001",
      "pp_001"
    ],
    "full_campaign_requires_gold_100": true,
    "gold_gate_stages": [
      "qa_only_authoring_contract",
      "bounded_exact_simulator_repair"
    ],
    "publish_sidecar_only_in_draft_pr": true
  },
  "models": {
    "first_pass": "gpt-5.6-luna",
    "first_pass_reasoning_effort": "medium",
    "escalation": "gpt-5.6-terra",
    "escalation_reasoning_effort": "medium",
    "max_output_tokens": 12000,
    "final_cleanup_max_output_tokens": 18000,
    "structured_outputs_strict": true,
    "pricing_usd_per_million_tokens": {
      "gpt-5.6-luna": {
        "input": 0.2,
        "output": 1.2
      },
      "gpt-5.6-terra": {
        "input": 2,
        "output": 12
      }
    },
    "final_cleanup": "gpt-5.6-terra",
    "final_cleanup_reasoning_effort": "medium",
    "attempt_sequence": [
      "gpt-5.6-luna",
      "gpt-5.6-terra",
      "gpt-5.6-terra"
    ]
  },
  "budget": {
    "currency": "USD",
    "warning_budget": 12,
    "hard_budget": 18,
    "max_concurrent_calls": 4,
    "stop_before_projected_overrun": true,
    "record_actual_token_usage": true,
    "repeat_same_idempotency_key": false
  },
  "publication": {
    "target_branch_prefix": "qa/105-case-refresh-",
    "draft_pull_request_only": true,
    "auto_merge": false,
    "main_branch_direct_write": false,
    "exclude_failed_candidates": true
  },
  "certification": {
    "require_exact_source_counts": true,
    "require_unique_case_ids": true,
    "evaluate_every_case_in_exact_html_engine": true,
    "deterministic_repetitions_per_case": 2,
    "require_direct_html_wrapper_parity": true,
    "require_pre_post_identity_manifest_match": true,
    "require_content_validation_before_draft_pr": true,
    "allowed_changed_paths": [
      "artifacts/dedektif/data/puzzles.ts",
      "artifacts/dedektif/data/puzzles_database.json",
      "artifacts/dedektif/qa/**"
    ]
  }
}
